#!/usr/bin/env python3
"""Build a new task definition from the CURRENT live one, swapping only the
image. Never build from a checked-in or previously-registered copy - that
copy can reference something (a secret, a parameter, a role) that has
since been deleted, and the pipeline won't find out until deployment fails.

Usage: render_taskdef.py <current-taskdef.json> <new-image-uri>
"""
import json
import sys

current_taskdef_path, new_image = sys.argv[1], sys.argv[2]

with open(current_taskdef_path) as f:
    td = json.load(f)

container = td["containerDefinitions"][0]
container["image"] = new_image

# Only the fields register-task-definition actually accepts - describe-
# task-definition returns extra read-only fields (revision, status, ARNs)
# that must be stripped before re-registering.
clean = {
    "family": td["family"],
    "networkMode": td["networkMode"],
    "requiresCompatibilities": td["requiresCompatibilities"],
    "cpu": td["cpu"],
    "memory": td["memory"],
    "executionRoleArn": td["executionRoleArn"],
    "containerDefinitions": [container],
}
if "runtimePlatform" in td:
    clean["runtimePlatform"] = td["runtimePlatform"]

print(json.dumps(clean, indent=2))

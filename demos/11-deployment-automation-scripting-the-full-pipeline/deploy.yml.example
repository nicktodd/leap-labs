# Example GitHub Actions workflow for the mission-service pipeline.
#
# This file is illustrative, not wired up in this labs repo - copy it to
# .github/workflows/deploy.yml in the mission-service's own repository (the
# one containing its Dockerfile) once that repo exists on GitHub, and update
# the placeholders below.

name: Build and Deploy mission-service

on:
  push:
    branches: [main]

permissions:
  id-token: write   # required to request the OIDC token used below
  contents: read

env:
  AWS_REGION: us-east-1
  ECR_REPOSITORY: leap-mission-service
  ECS_CLUSTER: leap-mission-cluster
  ECS_SERVICE: leap-mission-service
  TASK_FAMILY: leap-mission-service

jobs:
  build-and-deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Check out source
        uses: actions/checkout@v4

      # No static AWS access keys anywhere in this workflow or in GitHub
      # secrets - this step exchanges GitHub's own short-lived OIDC token
      # for temporary AWS credentials, scoped to exactly the role below.
      - name: Configure AWS credentials via OIDC
        uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::<account-id>:role/leap-github-actions-deploy-role
          aws-region: ${{ env.AWS_REGION }}

      - name: Log in to ECR
        id: ecr-login
        uses: aws-actions/amazon-ecr-login@v2

      - name: Build and push the image
        env:
          ECR_REGISTRY: ${{ steps.ecr-login.outputs.registry }}
          IMAGE_TAG: ${{ github.sha }}
        run: |
          docker build -t $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG .
          docker push $ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG

      # Starts from the CURRENT live task definition and only swaps the
      # image - not from an old local copy that might reference resources
      # (like a deleted secret) that no longer exist. See the demo guide's
      # "A Real Failure" section for exactly what goes wrong otherwise.
      - name: Render new task definition
        id: render-task-def
        uses: aws-actions/amazon-ecs-render-task-definition@v1
        with:
          task-definition-family: ${{ env.TASK_FAMILY }}
          container-name: mission-service
          image: ${{ steps.ecr-login.outputs.registry }}/${{ env.ECR_REPOSITORY }}:${{ github.sha }}

      - name: Deploy to ECS
        uses: aws-actions/amazon-ecs-deploy-task-definition@v2
        with:
          task-definition: ${{ steps.render-task-def.outputs.task-definition }}
          service: ${{ env.ECS_SERVICE }}
          cluster: ${{ env.ECS_CLUSTER }}
          wait-for-service-stability: true
